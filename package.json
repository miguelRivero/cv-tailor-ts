{
  "name": "cv-tailor-ai-ts",
  "version": "2.0.0",
  "description": "Automated CV adaptation system using LLM intelligence - TypeScript version with PDF support",
  "main": "dist/index.js",
  "type": "commonjs",
  "workspaces": [
    "worker",
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --ext .ts,.tsx src tests web/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:worker": "npm run -w worker typecheck",
    "dev:worker": "npm run -w worker dev",
    "typecheck:web": "npm run -w web typecheck",
    "build:web": "npm run typecheck:web && npm run -w web build",
    "dev:web": "npm run -w web dev",
    "validate": "npm run build && npm run lint && npm run format:check && npm test && npm run typecheck:worker && npm run build:web",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "husky"
  },
  "keywords": [
    "cv",
    "resume",
    "ai",
    "llm",
    "openai",
    "pdf",
    "typescript"
  ],
  "author": "Miguel Rivero López <miguelriveroloop@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.0",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^21.6.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "16.4.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yaml,yml}": "prettier --write"
  }
}
