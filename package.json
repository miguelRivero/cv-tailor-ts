{
  "name": "cv-tailor-ai-ts",
  "version": "2.0.0",
  "description": "Automated CV adaptation system using LLM intelligence - TypeScript version with PDF support",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cv",
    "resume",
    "ai",
    "llm",
    "openai",
    "pdf",
    "typescript"
  ],
  "author": "Miguel Rivero López <miguelriveroloop@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.0",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^21.6.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
