# Vite env for the web app (this file lives next to web/vite.config.ts).
# Copy to `.env` or `.env.local` (gitignored). Values prefixed VITE_ are
# inlined into the bundle at build time and are therefore public.

# Leave empty in development so `/api` goes through the Vite proxy to
# wrangler on 8787. In production this is the worker origin, no trailing
# slash, e.g. https://cv-tailor-worker.your-subdomain.workers.dev
VITE_WORKER_URL=

# Must match worker/.dev.vars CLIENT_TOKEN. The same value is sent as
# the X-CV-Tailor-Key header. It ships in the JS bundle; the worker's
# rate limit and the OpenAI monthly cap are what actually bound spend.
VITE_CLIENT_TOKEN=dev-local-token
