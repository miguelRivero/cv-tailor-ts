# Local development secrets for `npm run dev:worker` (wrangler dev).
# Copy this file to `.dev.vars` (gitignored) and fill in real values.
# Production secrets are set separately with `wrangler secret put` -
# see docs/WEB.md.

OPENAI_API_KEY=sk-your-key-here

# Any random string - this is the shared passphrase the web app sends
# as the X-CV-Tailor-Key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIENT_TOKEN=dev-local-token
