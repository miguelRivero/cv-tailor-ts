{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-tailor-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",

  // Non-secret configuration. OPENAI_API_KEY and CLIENT_TOKEN are set
  // with `wrangler secret put` (production) or worker/.dev.vars (local
  // dev) instead - see .dev.vars.example.
  "vars": {
    "ALLOWED_MODELS": "gpt-4o,gpt-4o-mini,gpt-4.1-mini",
    "MAX_OFFER_CHARS": "24000",
    "DAILY_REQUEST_LIMIT": "50",
  },

  // Backs the daily request counter (see src/lib/rateLimit.ts). The ids
  // below are placeholders: local `wrangler dev` simulates KV entirely
  // on disk regardless of their value, but a real deploy needs real
  // ids from `wrangler kv namespace create RATE_KV` pasted in here -
  // see docs/WEB.md for the one-time setup steps.
  "kv_namespaces": [
    {
      "binding": "RATE_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_NAMESPACE_ID",
    },
  ],
}
